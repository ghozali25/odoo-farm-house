<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data>
    <!-- Rename the MRP menu to "Farm Interventions" -->
    <record id="mrp.menu_mrp_root" model="ir.ui.menu">
        <field name="name">Farm Interventions</field>
        <field name="web_icon">farm_operation,static/description/icon.png</field>
    </record>

    <!-- Mrp Production Form View Inherit -->
    <record id="mrp_production_form_view_inherit_farm_op" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.farm.op</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="btn-primary" invisible="approval_state != 'draft'"/>
                <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="approval_state != 'to_approve'" groups="mrp.group_mrp_manager"/>
                <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="approval_state != 'to_approve'" groups="mrp.group_mrp_manager"/>
                <button name="action_start_work" string="Start Agri Work" type="object" class="btn-info" invisible="state != 'confirmed' or is_working"/>
                <button name="action_stop_work" string="Stop Agri Work" type="object" class="btn-warning" invisible="not is_working"/>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="attributes">
                <attribute name="string">Recipe/Formula</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="after">
                <field name="intervention_type" />
            </xpath>
            <xpath expr="//sheet" position="before">
                <!-- farm_ux (batch 2) is installed now: widget restored. -->
                <widget name="agri_gating_audit"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                    <page string="Sustainability &amp; Value" name="sustainability">
                        <group>
                            <group string="Carbon &amp; Impact">
                                <field name="carbon_intensity" widget="gauge" options="{'max_value': 50, 'label': 'kg CO2e'}" />
                                <field name="esg_score" />
                                <field name="is_eco_blocked" readonly="1" />
                            </group>
                            <group string="Community Clearing">
                                <field name="impact_credits" decoration-success="impact_credits &gt; 0" widget="monetary" />
                                <field name="clearing_status" widget="badge" decoration-info="clearing_status == 'calculated'" decoration-success="clearing_status == 'settled'" />
                            </group>
                        </group>
                    </page>
                    <page string="Spatial &amp; Evidence" name="evidence">
                        <group>
                            <group string="Spatial Compliance Audit">
                                <!-- farm_ux (batch 2) installed: widget restored. -->
                                <widget name="agri_spatial_gauge"/>
                            </group>
                            <group string="Physical Grounding">
                                <field name="geo_point" />
                                <field name="spatial_grid_id" />
                            </group>
                        </group>
                        <group>
                            <group string="AI Audit">
                                <field name="audit_confidence" widget="progressbar" />
                                <field name="audit_status" widget="badge" decoration-danger="audit_status == 'fraudulent'" decoration-success="audit_status == 'verified'" />
                            </group>
                        </group>
                        <group string="Quality Fingerprint (Immutable Proof)">
                            <!-- B6 fix (10 Nov 2026): mode MUST be a CodeEditor.MODES
                                 value (javascript/xml/qweb/scss/python). 'json' is NOT
                                 one of them: in ?debug=1 Owl prop validation raises
                                 "Invalid props for component 'CodeEditor': 'mode' is
                                 not valid" and the whole tab Oopses; in non-debug Ace
                                 404s on mode-json.js. 'javascript' is correct here:
                                 the fingerprint is JSON text (json.dumps) and JSON is
                                 a JS object-literal subset, so highlighting fits. -->
                            <field name="quality_fingerprint" widget="ace" options="{'mode': 'javascript'}" />
                        </group>
                    </page>
                    <page string="Soil Nutrient Balance" name="nutrient_balance" invisible="intervention_type not in ['fertilizing', 'tillage']">
                        <group>
                            <group string="Nutrient Application Visualization">
                                <!-- farm_ux (batch 2) installed: widget restored. -->
                                <widget name="agri_nutrient_gauge" />
                            </group>
                            <group string="Current Application (Pure Nutrient)">
                                <field name="pure_n_qty" />
                                <field name="pure_p_qty" />
                                <field name="pure_k_qty" />
                            </group>
                        </group>
                    </page>
                </xpath>
        </field>
    </record>

    <!-- B7b/B7c fix (10 Nov 2026): dedicated PRIMARY form view for
         agri.intervention. The model previously had NO form view of its
         own, so the web client rendered an auto-generated form that
         included production_id (the required _inherits link to
         mrp.production) empty -> client-side validation refused Save
         before the request ever reached the server, even though
         create() already auto-creates the MO when production_id is
         absent (B7b, fatal). This view deliberately OMITS
         production_id: the client does not validate fields that are
         not in the view, and the server-side _inherits create still
         creates the MO automatically. It is the default form view for
         the model (mode primary, priority 16, the only form view),
         so it also opens on direct URLs
         /web#id=<id>&model=agri.intervention&view_type=form.
         B7c: name is editable here (readonly="0" + force_save="1");
         see models/farm_agricultural_intervention.py create() for
         why no server-side name hack is needed. -->
    <record id="view_agri_intervention_form" model="ir.ui.view">
        <field name="name">agri.intervention.form</field>
        <field name="model">agri.intervention</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <form string="Agricultural Intervention">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="btn-primary" invisible="approval_state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="approval_state != 'to_approve'" groups="mrp.group_mrp_manager"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="approval_state != 'to_approve'" groups="mrp.group_mrp_manager"/>
                    <button name="action_start_work" string="Start Agri Work" type="object" class="btn-info" invisible="state != 'confirmed' or is_working"/>
                    <button name="action_stop_work" string="Stop Agri Work" type="object" class="btn-warning" invisible="not is_working"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="0" force_save="1" placeholder="e.g. Fertilizing Tomatoes Block A1"/></h1>
                    </div>
                    <group>
                        <group string="Intervention">
                            <field name="intervention_type"/>
                            <field name="biological_asset_id"/>
                            <field name="agri_task_id"/>
                            <field name="campaign_id"/>
                            <field name="location_id"/>
                            <field name="procedure_name"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Production">
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                            <field name="bom_id"/>
                            <field name="picking_type_id"/>
                            <field name="location_src_id"/>
                            <field name="location_dest_id"/>
                            <field name="date_deadline"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Approval">
                            <field name="approval_state"/>
                            <field name="approver_id"/>
                            <field name="approval_date"/>
                            <field name="simplified_state"/>
                        </group>
                        <group string="Schedule">
                            <field name="date_planned_start"/>
                            <field name="date_planned_finished"/>
                            <field name="date_start"/>
                            <field name="date_finished"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Execution" name="execution">
                            <group>
                                <group string="Work">
                                    <field name="work_start_datetime"/>
                                    <field name="is_working"/>
                                    <field name="intervention_count"/>
                                    <field name="expected_yield_accuracy"/>
                                    <field name="last_metrology_date"/>
                                </group>
                                <group string="Harvest Grading">
                                    <field name="grade_a_qty"/>
                                    <field name="grade_b_qty"/>
                                    <field name="grade_c_qty"/>
                                </group>
                            </group>
                            <group>
                                <group string="Tools &amp; Operator">
                                    <field name="tool_ids" widget="many2many_tags"/>
                                    <field name="drone_id"/>
                                    <field name="actual_flight_area"/>
                                    <field name="operator_id_card"/>
                                    <field name="product_registration_no"/>
                                </group>
                            </group>
                        </page>
                        <page string="Components" name="components">
                            <field name="move_raw_ids" readonly="1">
                                <!-- B7b fix (koordinator, 10 Nov 2026): tag HARUS <list>,
                                     BUKAN <tree> — di Odoo 18 _validate_tag_field hanya
                                     merekursi sub-view bila child.tag in ('form','list',
                                     'graph','kanban','calendar'); <tree> dilewati sehingga
                                     field di dalamnya divalidasi terhadap model form
                                     (agri.intervention) dan upgrade gagal
                                     "Field product_uom does not exist". -->
                                <list>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <field name="move_finished_ids" readonly="1">
                                <!-- B7b fix (koordinator): <list>, bukan <tree> — lihat
                                     komentar di move_raw_ids di atas. -->
                                <list>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Costs &amp; Nutrients" name="costs">
                            <group>
                                <group string="Costs">
                                    <field name="input_cost"/>
                                    <field name="tool_cost"/>
                                    <field name="doer_cost"/>
                                    <field name="energy_cost"/>
                                    <field name="total_agri_cost"/>
                                </group>
                                <group string="Pure Nutrients (kg)">
                                    <field name="pure_n_qty"/>
                                    <field name="pure_p_qty"/>
                                    <field name="pure_k_qty"/>
                                </group>
                            </group>
                        </page>
                        <page string="Gating &amp; Audit" name="gating">
                            <group>
                                <group string="Gating">
                                    <field name="weather_gating_status"/>
                                    <field name="compliance_gating_status"/>
                                    <field name="iot_status"/>
                                </group>
                                <group string="Spatial Audit">
                                    <field name="spatial_compliance_rate"/>
                                    <field name="out_of_bounds_count"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="mrp_production_kanban_view_inherit_farm" model="ir.ui.view">
        <field name="name">mrp.production.kanban.inherit.farm</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name" />
                <field name="product_id" />
                <field name="intervention_type" />
                <field name="state" />
                <field name="weather_gating_status" />
                <field name="compliance_gating_status" />
                <field name="iot_status" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="name" /></strong>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'confirmed': 'info', 'progress': 'warning', 'done': 'success'}}" />
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-tag me-1" /> <field name="intervention_type" /></div>
                                <div><i class="fa fa-cube me-1" /> <field name="product_id" /></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-2">
                                    <i class="fa fa-sun-o" t-if="record.weather_gating_status.raw_value == 'safe'" title="Weather Safe" style="color: green;" />
                                    <i class="fa fa-umbrella" t-if="record.weather_gating_status.raw_value == 'blocked'" title="Weather Blocked" style="color: red;" />
                                    <i class="fa fa-shield" t-if="record.compliance_gating_status.raw_value == 'compliant'" title="Compliant" style="color: green;" />
                                    <i class="fa fa-ban" t-if="record.compliance_gating_status.raw_value == 'blocked'" title="Non-Compliant" style="color: red;" />
                                    <i class="fa fa-wifi" t-if="record.iot_status.raw_value == 'connected'" title="IoT Connected" style="color: green;" />
                                    <i class="fa fa-times-circle" t-if="record.iot_status.raw_value == 'offline'" title="IoT Offline" style="color: orange;" />
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="responsible_id" widget="many2one_avatar_user" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mrp_production_calendar_view_inherit_farm" model="ir.ui.view">
        <field name="name">mrp.production.calendar.inherit.farm</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <calendar string="Intervention Schedule" date_start="date_start" date_stop="date_finished" color="intervention_type" quick_create="0">
                <field name="name" />
                <field name="product_id" />
                <field name="intervention_type" filters="1" />
            </calendar>
        </field>
    </record>

    <record id="mrp_production_pivot_view_inherit_farm" model="ir.ui.view">
        <field name="name">mrp.production.pivot.inherit.farm</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Intervention Analysis" sample="1">
                <field name="date_finished" interval="month" type="col" />
                <field name="intervention_type" type="row" />
                <field name="product_qty" type="measure" />
                <field name="total_agri_cost" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
    </record>
</data>
</odoo>
