<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_stock_lot_kanban_livestock" model="ir.ui.view">
        <field name="name">stock.lot.kanban.livestock</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <!-- NOTE (18.0 port): NO default_group_by here. The field
                 biological_stage is a computed, non-stored field, and Odoo 18
                 read_group raises "Cannot convert ... to SQL because it is
                 not stored" for such a groupby — the kanban (the default
                 view of this action) would fail to open. Grouping can still
                 be chosen manually on stored fields. -->
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id" />
                <field name="name" />
                <field name="product_id" />
                <field name="animal_count" />
                <field name="current_predicted_weight" />
                <field name="biological_stage" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="name" /></strong>
                                <span class="badge rounded-pill bg-info float-end"><field name="animal_count" /> animals</span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="product_id" /></div>
                                <div class="text-muted">
                                    Predicted Weight: <field name="current_predicted_weight" widget="float" options="{'precision': 2}" /> kg
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="biological_stage" widget="label_selection" options="{'classes': {'born': 'info', 'growing': 'warning', 'finished': 'success', 'harvested': 'default'}}" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    
    <record id="view_stock_lot_pivot_livestock" model="ir.ui.view">
        <field name="name">stock.lot.pivot.livestock</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <pivot string="Livestock Analysis">
                <field name="product_id" type="row" />
                <field name="biological_stage" type="col" />
                <!-- NOTE (18.0 port): animal_count was a measure here, but it
                     is a computed, non-stored field and Odoo 18 read_group
                     raises "Cannot convert ... to SQL because it is not
                     stored" for non-stored measures — the pivot would fail
                     to open. Kept measures are stored fields only
                     (current_predicted_weight is store=True). -->
                <field name="current_predicted_weight" type="measure" />
            </pivot>
        </field>
    </record>

    
    <record id="action_livestock_lot" model="ir.actions.act_window">
        <field name="name">Animal Batches</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">kanban,list,form,pivot</field>
        <field name="context">{'search_default_group_by_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage your livestock batches and track their growth.
            </p>
        </field>
    </record>

    
    <menuitem id="menu_livestock_lot" name="Batches &amp; Groups" parent="menu_farm_livestock_root" action="action_livestock_lot" sequence="5" />
</data>
</odoo>