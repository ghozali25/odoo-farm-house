<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_farm_industry_workcenter_form" model="ir.ui.view">
        <field name="name">farm.industry.workcenter.form</field>
        <field name="model">farm.industry.workcenter</field>
        <field name="arch" type="xml">
            <form string="Facility">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="workcenter_id" placeholder="Workcenter" /></h1>
                    </div>
                    <group>
                        <field name="facility_type" />
                        <field name="surface_area" />
                        <field name="volume_capacity" />
                        <field name="has_climate_control" />
                        <field name="main_sensor_topic" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</data>
</odoo>