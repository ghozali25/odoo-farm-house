<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_farm_lot_harvest_form" model="ir.ui.view">
        <field name="name">farm.lot.harvest.form</field>
        <field name="model">farm.lot.harvest</field>
        <field name="arch" type="xml">
            <form string="Harvest Lot">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Harvest Batch Ref" />
                        <h1><field name="name" placeholder="e.g. CORN-2026-P01" /></h1>
                    </div>
                    <group>
                        <group string="Core Product">
                            <field name="product_id" readonly="1" />
                            <field name="product_qty" />
                        </group>
                        <group string="Terroir &amp; Origin">
                            <field name="plot_id" />
                            <field name="terroir_attributes_json" widget="ace" options="{'mode': 'javascript'}" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
</data>
</odoo>