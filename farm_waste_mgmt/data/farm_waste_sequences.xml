<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<!-- Sequences for the reference numbers generated in create().
     Precedent: farm_processing/data/processing_data.xml defines its
     own sequence the same way instead of relying on the _('New')
     fallback in the model.
     NOTE: no sequence for ``farm.processing.waste`` here — it is
     already defined by farm_processing (data/processing_data.xml). -->
<record id="seq_agri_manure_batch" model="ir.sequence">
            <field name="name">Agricultural Manure Batch</field>
            <field name="code">agri.manure.batch</field>
            <field name="prefix">MNR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>
<record id="seq_agri_manure_ledger" model="ir.sequence">
            <field name="name">Agricultural Manure Ledger</field>
            <field name="code">agri.manure.ledger</field>
            <field name="prefix">MNL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False" />
        </record>
</data>
</odoo>
