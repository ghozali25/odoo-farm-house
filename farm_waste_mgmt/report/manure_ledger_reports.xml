<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="action_report_manure_ledger" model="ir.actions.report">
        <field name="name">Manure Ledger</field>
        <field name="model">agri.manure.ledger</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">farm_waste_mgmt.report_manure_ledger</field>
