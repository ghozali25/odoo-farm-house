<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_iiot_firmware_tree" model="ir.ui.view">
        <field name="name">iiot.firmware.tree</field>
        <field name="model">iiot.firmware</field>
        <field name="arch" type="xml">
            <list string="Firmware Version">
                <field name="name" />
                <field name="version" />
                <field name="profile_code" />
                <field name="checksum" />
                <field name="is_active" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    
    <record id="view_iiot_firmware_form" model="ir.ui.view">
        <field name="name">iiot.firmware.form</field>
        <field name="model">iiot.firmware</field>
        <field name="arch" type="xml">
            <form string="Firmware Version">
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="version" />
                            <field name="profile_code" />
                        </group>
                        <group>
                            <field name="checksum" />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                        <field name="is_active" />
                    </group>
                    <notebook>
                        <page string="Device Update History" name="updates">
                            <!-- NOTE (Odoo 18 port): upstream left this page
                                 empty; wired to the new One2many
                                 iiot.firmware.update_ids. -->
                            <field name="update_ids" nolabel="1">
                                <list>
                                    <field name="name" />
                                    <field name="device_id" />
                                    <field name="status" />
                                    <field name="progress" />
                                    <field name="create_date" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="action_iiot_firmware" model="ir.actions.act_window">
        <field name="name">Firmware Version</field>
        <field name="res_model">iiot.firmware</field>
        <field name="view_mode">list,form</field>
    </record>
</data>
</odoo>