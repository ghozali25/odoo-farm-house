<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_farm_aquaculture_operation_form" model="ir.ui.view">
        <field name="name">farm.aquaculture.operation.form</field>
        <field name="model">farm.aquaculture.operation</field>
        <!-- B14 fix (2026-11-10): mode="primary" (was extension). As a mere
             extension of project.view_task_form2 (id 2314, model
             project.task) with no primary view of its own, this model had
             no primary form view, so fields_view_get fell back to an
             auto-generated default form without the notebook/tab
             "Aquaculture Information". A primary view WITH inherit_id is
             the standard Odoo pattern (cf. helpdesk inheriting the
             project.task form): its arch is the parent's arch plus the
             xpath below, and it becomes the default form view resolved
             for this model. inherit_id + xpath unchanged. -->
        <field name="mode">primary</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra_info']" position="after">
                <page string="Aquaculture Information" name="aquaculture_info">
                    <group name="pond_info" string="Pond/Tank Information">
                        <field name="pond_id" />
                        <field name="pond_capacity" />
                        <field name="aquatic_species" />
                        <field name="initial_stocking" />
                        <field name="current_count" />
                        <field name="aquaculture_stage" />
                    </group>
                    <group name="water_quality" string="Water Quality Management">
                        <group name="water_params" string="Water Parameters">
                            <field name="water_temperature" />
                            <field name="ph_level" />
                            <field name="dissolved_oxygen" />
                            <field name="water_quality_status" />
                        </group>
                        <group name="water_chemistry" string="Water Chemistry">
                            <field name="ammonia_level" />
                            <field name="nitrite_level" />
                        </group>
                    </group>
                    <group name="feeding_info" string="Feeding Management">
                        <field name="daily_feeding_rate" />
                        <field name="last_feeding_date" />
                        <field name="feeding_schedule" />
                    </group>
                    <group name="growth_tracking" string="Growth Tracking">
                        <field name="avg_initial_weight" />
                        <field name="avg_current_weight" />
                        <field name="growth_rate" />
                        <field name="target_weight" />
                    </group>
                    <group name="harvest_info" string="Harvest Management">
                        <field name="harvest_readiness" />
                        <field name="harvest_plan_date" />
                    </group>
                    <group name="water_system" string="Water Treatment &amp; Circulation">
                        <field name="water_treatment_method" />
                        <field name="circulation_rate" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    
    <record id="view_farm_aquaculture_operation_tree" model="ir.ui.view">
        <field name="name">farm.aquaculture.operation.tree</field>
        <field name="model">farm.aquaculture.operation</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="pond_id" />
                <field name="aquatic_species" />
                <field name="current_count" />
                <field name="water_quality_status" />
                <field name="avg_current_weight" />
                <field name="harvest_readiness" />
                <field name="aquaculture_stage" />
            </field>
        </field>
    </record>

    
    <record id="view_farm_water_quality_log_form" model="ir.ui.view">
        <field name="name">farm.water.quality.log.form</field>
        <field name="model">farm.water.quality.log</field>
        <field name="arch" type="xml">
            <form string="Water Quality Log">
                <sheet>
                    <group>
                        <group name="main_info">
                            <field name="operation_id" />
                            <field name="log_date" />
                        </group>
                        <group name="water_parameters">
                            <field name="temperature" />
                            <field name="ph_level" />
                            <field name="dissolved_oxygen" />
                            <field name="ammonia_level" />
                            <field name="nitrite_level" />
                        </group>
                    </group>
                    <group string="Additional Parameters">
                        <field name="water_turbidity" />
                        <field name="water_salinity" />
                    </group>
                    <group>
                        <field name="weather_conditions" />
                    </group>
                    <group>
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="view_farm_water_quality_log_tree" model="ir.ui.view">
        <field name="name">farm.water.quality.log.tree</field>
        <field name="model">farm.water.quality.log</field>
        <field name="arch" type="xml">
            <list string="Water Quality Logs">
                <field name="log_date" />
                <field name="operation_id" />
                <field name="temperature" />
                <field name="ph_level" />
                <field name="dissolved_oxygen" />
                <field name="ammonia_level" />
                <field name="nitrite_level" />
                
            </list>
        </field>
    </record>

    
    <record id="action_farm_aquaculture_operations" model="ir.actions.act_window">
        <field name="name">Aquaculture Operations</field>
        <field name="res_model">farm.aquaculture.operation</field>
        <field name="view_mode">list,form</field>
        <!-- B14 side-effect fix (2026-11-10): view_id DIHAPUS dari action.
             Pinning view_id ke view FORM (2772) membuat action 1024
             langsung membuka form New dari menu, bukan daftar.
             Perhatian: sekadar menghapus baris <field name="view_id">
             dari XML TIDAK membersihkan DB (update record Odoo hanya
             menulis field yang ada di XML; nilai lama 2772 bertahan —
             terbukti di salinan test18_b12res sesudah upgrade). Karena
             itu view_id dikosongkan eksplisit dengan eval="False".
             Primary form view di atas (mode=primary, view 2772) sudah
             menjadi default form view yang diresolusi untuk model ini,
             jadi pin eksplisit tidak diperlukan; view_mode list,form
             mengembalikan perilaku daftar-dulu seperti sebelum fix B14
             (saat view_id NULL dan daftar terbuka normal). -->
        <field name="view_id" eval="False" />
    </record>

    
    <record id="action_farm_water_quality_logs" model="ir.actions.act_window">
        <field name="name">Water Quality Logs</field>
        <field name="res_model">farm.water.quality.log</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <menuitem id="menu_farm_aquaculture_root" name="Aquaculture" web_icon="farm_aquaculture,static/description/icon.png" sequence="23" />

    <menuitem id="menu_farm_aquaculture_operations" name="Operations" parent="menu_farm_aquaculture_root" action="action_farm_aquaculture_operations" sequence="10" />

    <menuitem id="menu_farm_water_quality_logs" name="Water Quality Logs" parent="menu_farm_aquaculture_root" action="action_farm_water_quality_logs" sequence="20" />
</data>
</odoo>