<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="seq_agri_quality_record_book" model="ir.sequence">
        <field name="name">Quality Record Book Sequence</field>
        <field name="code">agri.quality.record.book</field>
        <field name="prefix">RB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="seq_agri_quality_check" model="ir.sequence">
        <field name="name">Quality Check Sequence</field>
        <field name="code">agri.quality.check</field>
        <field name="prefix">QC/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
    <record id="seq_agri_quality_sample" model="ir.sequence">
        <field name="name">Quality Sample Sequence</field>
        <field name="code">agri.quality.sample</field>
        <field name="prefix">SMP/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
</data>
</odoo>