            <field name="target_term">AI</field>
            <field name="language_code">en_US</field>
            <field name="industry_context">general</field>
            <!-- NOTE (porting batch 2): DEACTIVATED — the term engine applies
                 regex WITHOUT word boundaries, case-insensitive, so "MO"
                 corrupts any word containing it ("Model"→"AIdel",
                 "Month"→"AI nth"). The engine itself is upstream logic and
                 was not rewritten; this single mapping stays off until a
                 word-boundary fix lands upstream. -->
            <field name="is_active">False</field>
            <field name="description">Maps the MO abbreviation to Agricultural Intervention</field>
            <field name="example_usage">Replaces the MO abbreviation in the system with AI (Agricultural Intervention)</field>
