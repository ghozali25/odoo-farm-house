<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 6: upstream FarmSubsidyApplication.create() calls
     ir.sequence next_by_code('farm.subsidy.application') but no sequence
     exists in the module (next_by_code returns False -> name falls back
     to 'SUB'). Define it so applications get real numbers. -->
<odoo>
<data>
    <record id="seq_farm_subsidy_application" model="ir.sequence">
        <field name="name">Subsidy Application</field>
        <field name="code">farm.subsidy.application</field>
        <field name="prefix">SUB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False" />
    </record>
</data>
</odoo>
