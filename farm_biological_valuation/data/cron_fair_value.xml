<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="ir_cron_recalculate_fair_values" model="ir.cron">
            <field name="name">Agricultural Assets: Real-time Fair Value Conversion</field>
            <field name="model_id" ref="model_farm_biological_valuation_mixin" />
            <field name="state">code</field>
            <!-- NOTE (18.0 port): this file is intentionally NOT listed in
                 __manifest__.py yet: no concrete model inherits
                 farm.biological.valuation.mixin, so the cron would only run the
                 no-op hook cron_recalculate_fair_values(). Enable it once a
                 concrete model uses the mixin. -->
            <field name="code">model.cron_recalculate_fair_values()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="doall" eval="False" />
            <field name="active" eval="True" />
        </record>
</data>
</odoo>